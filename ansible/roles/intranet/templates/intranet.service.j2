[Unit]
Description=HKU ENGG Intranet ({{ intranet_role }} site {{ inventory_hostname }})
Documentation=products/Demo_hku/deliverable/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

# --network host   the application is served directly on the host's port
# --pull=never     the image is already in the site's local podman store;
#                  never reach for the registry at start-up
# --env-file       the configuration and the secrets stay on the host, at
#                  mode 0600, and never travel through Jenkins
# :z               the SELinux relabel the bind mount needs on RHEL
ExecStartPre=-/usr/bin/podman rm -f {{ intranet_container_name }}
ExecStart=/usr/bin/podman run --rm --name {{ intranet_container_name }} --pull=never --network host --env-file {{ intranet_env_file }} -v {{ intranet_backups_dir }}:/app/backups:z {{ intranet_image }}
ExecStop=/usr/bin/podman stop -t 15 {{ intranet_container_name }}
ExecStopPost=/usr/bin/podman rm -f {{ intranet_container_name }}

[Install]
WantedBy=default.target
